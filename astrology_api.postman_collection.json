  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email",
      "value": "api.test@example.com"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "astrologer_id",
      "value": ""
    },
    {
      "key": "consultation_id",
      "value": ""
    },
    {
      "key": "call_id",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
